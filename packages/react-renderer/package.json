{
  "name": "@toon-json-render/react",
  "version": "0.1.0",
  "description": "React renderer that accepts TOON input and renders via json-render",
  "author": "abhishekgahlot2",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishekgahlot2/toon-json-render",
    "directory": "packages/react-renderer"
  },
  "homepage": "https://github.com/abhishekgahlot2/toon-json-render#readme",
  "bugs": "https://github.com/abhishekgahlot2/toon-json-render/issues",
  "keywords": ["toon", "json-render", "react", "generative-ui", "llm", "streaming"],
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@toon-json-render/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
